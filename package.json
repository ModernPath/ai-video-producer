{
  "name": "ai-video-director",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b libs/*/tsconfig.json",
    "compose:up": "docker compose up -d",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "test:real": "RUN_REAL_API=1 vitest run libs/gen/tests/real-api.e2e.spec.ts",
    "style": "tsx scripts/style-card.ts",
    "audit:prompts": "tsx scripts/audit-prompts.ts"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  }
}
