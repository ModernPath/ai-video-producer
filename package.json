{
  "name": "ai-video-director",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b libs/*/tsconfig.json",
    "compose:up": "docker compose up -d",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "test:real": "RUN_REAL_API=1 vitest run libs/gen/tests/real-api.e2e.spec.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "uuid": "^11.0.0",
    "postgres": "^3.4.5"
  }
}
