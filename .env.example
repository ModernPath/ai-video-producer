# Local development defaults — these match docker-compose.yml and are throwaway values for a
# localhost-only stack. They are NOT credentials; do not reuse them anywhere reachable.
DATABASE_URL=postgres://avd:avd@localhost:54329/avd
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=avd
S3_SECRET_KEY=avd-secret
S3_BUCKET=avd-media

# Generation: MOCK_GEN=1 returns fixture media, zero API cost (default for dev/CI)
MOCK_GEN=1
# Your own key from https://ai.google.dev — required only when MOCK_GEN is unset.
# Never commit a real key: .env and .env.local are gitignored.
GEMINI_API_KEY=
