# REQ-PLT-004 — Kamal secrets for the AI Video Producer.
#
# Every name here must also appear under `env.secret` in config/deploy.yml (or under an accessory's
# `env.secret`), or it is read here and never reaches the container.
#
# Values come from the repo-root .env:  dotenv -f .env -- kamal deploy
# (or `set -a && . ./.env && set +a && kamal deploy`)

# GitHub Container Registry (ghcr.io/modernpath)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# PostgreSQL — the accessory container is reachable as `video-creator-db` on the Kamal docker
# network. The name is <service>-db; changing `service:` in deploy.yml changes this host.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgresql://video_creator:$POSTGRES_PASSWORD@video-creator-db:5432/video_creator_prod

# Auth.js v5 (REQ-PLT-002). AUTH_GOOGLE_ID/SECRET are the shared Modernpath OAuth client; its
# authorized redirect URIs must include:
#   https://video-creator.modernpath.ai/api/auth/callback/google
AUTH_SECRET=$AUTH_SECRET
AUTH_GOOGLE_ID=$AUTH_GOOGLE_ID
AUTH_GOOGLE_SECRET=$AUTH_GOOGLE_SECRET

# Google Gemini — image, video and text generation (libs/gen). Spend is capped per org per day by
# config.gen.quota (GEN_DAILY_USD_CAP), not by anything here.
GEMINI_API_KEY=$GEMINI_API_KEY

# Hetzner Object Storage (S3-compatible), bucket `modernpath-video-creator` in hel1.
# NOTE the variable names: this app reads S3_ACCESS_KEY / S3_SECRET_KEY (libs/ast/src/storage.ts),
# not the S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY spelling other Modernpath apps use.
S3_ACCESS_KEY=$S3_ACCESS_KEY
S3_SECRET_KEY=$S3_SECRET_KEY
